{
  "name": "checkout-kata-prep",
  "license": "MIT",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "node scripts/seed.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch backend/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "test": "jest",
    "test:backend": "jest -c jest.backend.config.js",
    "test:frontend": "jest -c jest.frontend.config.js",
    "build": "tsc -p . && vite build --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.81.2",
    "better-sqlite3": "^9.1.0",
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "perf_hooks": "^0.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-icons": "^5.5.0",
    "supertest": "^7.1.1"
  },
  "devDependencies": {
    "@swc/core": "^1.12.7",
    "@swc/jest": "^0.2.38",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^15.0.7",
    "@types/better-sqlite3": "^7.6.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.10.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.4.4",
    "vite": "^6.3.5"
  }
}
